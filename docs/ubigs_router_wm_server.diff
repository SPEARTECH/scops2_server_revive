+            # 'Cancel Invite'. Follow up with fresh UPDATEFRIEND frames so the screen is refreshed.
+            import threading
+            def _refresh(_h=host, _j=str(joiner)):
+                try:
+                    e2 = _ONLINE.get(_h.lower())
+                    if e2 is not None:
+                        e2[1].sendall(_update_friend_frame(_j, _j.lower() in _ONLINE))
