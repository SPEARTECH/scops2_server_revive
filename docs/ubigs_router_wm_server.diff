+    import gsm
+    from data import List
+    r = gsm.GSMResponse(msg)
+    r.header.property = gsm.PROPERTY.GS
+    r.header.type = gsm.MESSAGE_TYPE.LOBBY_MSG
+    r.dl = List([str(subtype), payload])
